{
  "name": "pickrate",
  "version": "0.1.0",
  "description": "Does an agent actually pick your MCP tools and Agent Skills correctly? Zero-config surface linting and selection evals.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lach1an/pickrate.git"
  },
  "bugs": {
    "url": "https://github.com/lach1an/pickrate/issues"
  },
  "homepage": "https://github.com/lach1an/pickrate#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pickrate": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "eval",
    "llm",
    "agent",
    "tools",
    "agent-skills",
    "claude"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "gpt-tokenizer": "^3.4.0",
    "openai": "^7.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
